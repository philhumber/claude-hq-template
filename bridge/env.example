# slack-hq settings. install.ps1 copies this to .env; fill that in.
# Never commit .env and never paste its tokens into a chat, including with Claude.

# Bot User OAuth Token (xoxb-...): Slack app > OAuth & Permissions
SLACK_BOT_TOKEN=
# App-level token with connections:write (xapp-...): Slack app > Basic Information > App-Level Tokens
SLACK_APP_TOKEN=

# Your Slack member ID (U...): Profile > More > Copy member ID.
# The ONLY user whose messages and reactions reach HQ, and the only one who can approve.
SLACK_ALLOWED_USER=

# Channels HQ listens to (names or IDs, comma-separated). Invite the bot to each one.
SLACK_ALLOWED_CHANNELS=ceo,approvals,cos-briefing,agent-log,todo,it,support,marketing,research,finance,engineering

# Relay Claude Code permission prompts to Slack so you can approve from your phone.
SLACK_PERMISSION_RELAY=true
SLACK_PERMISSION_CHANNEL=approvals

# Channel for your to-do posts (Slack reserves the name "todos").
SLACK_TODO_CHANNEL=todo

# The watchdog (watchdog-hq.ps1) reads these channels through Slack's API.
# Channel > View channel details > the ID at the bottom (C...).
HQ_LOG_CHANNEL_ID=
HQ_CEO_CHANNEL_ID=

# Extra Bolt logging (1 to turn on)
SLACK_HQ_DEBUG=
